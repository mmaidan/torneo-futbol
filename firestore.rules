rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Los administradores tienen un documento admins/{email en minúsculas}
    // (su email de Google, o usuario@torneo.local si entran con usuario y
    // contraseña) con el campo rol: "admin" o "superadmin". Solo el superadmin
    // crea y borra esos documentos desde la app. El primero (con tu cuenta de
    // Google) se crea a mano en la consola.
    function email() {
      return request.auth.token.email.lower();
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(email());
    }

    // Identidad confiable: cuenta de Google (email verificado) o usuario creado
    // por la app, que usa el formato usuario@torneo.local. Un email sin verificar
    // de otro dominio NO sirve, para que nadie se registre con el correo de un admin.
    function trustedIdentity() {
      return request.auth != null
        && (request.auth.token.email_verified == true
            || (request.auth.token.firebase.sign_in_provider == 'password'
                && request.auth.token.email.matches('.*@torneo[.]local')));
    }

    function isAdmin() {
      return trustedIdentity() && exists(adminPath());
    }

    function isSuperAdmin() {
      return isAdmin() && get(adminPath()).data.rol == 'superadmin';
    }

    match /admins/{adminEmail} {
      // Cada admin lee su propio documento; el superadmin lee la lista completa.
      allow read: if isSuperAdmin()
        || (isAdmin() && adminEmail == email());
      // Solo el superadmin da de alta o de baja, y no puede borrarse a sí mismo
      // (para no quedarse sin superusuario).
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin() && adminEmail != email();
    }

    match /tournaments/{tournamentId} {
      // Cualquiera puede ver fixture, tabla y estadísticas.
      allow read: if true;
      // Solo administradores pueden crear, editar o borrar.
      allow write: if isAdmin();
    }
  }
}
