rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un usuario es administrador si existe el documento admins/{su uid}.
    // Ese documento se crea a mano desde la consola de Firebase
    // (las apps no pueden crearlo ni modificarlo).
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /tournaments/{tournamentId} {
      // Cualquiera puede ver fixture, tabla y estadísticas.
      allow read: if true;
      // Solo el administrador puede crear, editar o borrar.
      allow write: if isAdmin();
    }
  }
}
